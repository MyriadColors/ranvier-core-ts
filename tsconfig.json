{
	"compilerOptions": {
		"module": "ES2022",
		"target": "ES2022",
		"declaration": true,
		"outDir": "./dist/esm",
		"rootDir": "./src",
		"noImplicitAny": true,
		"strict": true,
		"esModuleInterop": true,
		"sourceMap": true,
		"moduleResolution": "Bundler",
		"types": ["node"]
	},
	"include": ["src/**/*", "types/**/*"]
}
