{
	"name": "ranvier",
	"description": "MUD game engine",
	"homepage": "https://ranviermud.com",
	"bugs": "https://github.com/Ranvier-TS/core-ts/issues",
	"license": "MIT",
	"author": "Shawn Biddle (http://shawnbiddle.com), Sean O'Donohue, Brian Nelson",
	"version": "3.2.2",
	"repository": "github:ranvier-ts/core-ts",
	"packageManager": "bun@1.2.4",
	"engines": {
		"node": ">= 20"
	},
	"scripts": {
		"test": "vitest run",
		"coverage": "vitest run --coverage",
		"prepare": "bun run build",
		"build": "tsc",
		"project": "bun x tsc -p tsconfig.json",
		"watch": "tsc --watch --project tsconfig.json",
		"lint": "eslint src/**/*.ts",
		"prepublish": "tsc -p tsconfig.json && tsc -p tsconfig-cjs.json",
		"docs:build": "typedoc",
		"docs:serve": "bun x http-server docs/api -p 8080"
	},
	"main": "./dist/cjs/index.js",
	"types": "./dist/index.d.ts",
	"module": "./dist/esm/index.js",
	"directory": [
		"./dist/esm"
	],
	"dependencies": {
		"@types/bcryptjs": "^3.0.0",
		"@types/js-yaml": "^4.0.9",
		"@types/uuid": "^11.0.0",
		"@types/winston": "^2.4.4",
		"@types/ws": "^8.18.1",
		"bcryptjs": "^3.0.3",
		"commander": "^15.0.0",
		"js-yaml": "^4.2.0",
		"pretty-error": "^4.0.0",
		"require-dir": "^1.2.0",
		"sty": "",
		"uuid": "^14.0.0",
		"winston": "^3.19.0",
		"wrap-ansi": "^10.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^25.9.2",
		"@vitest/coverage-v8": "^4.1.8",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"prettier": "^3.8.3",
		"typedoc": "^0.28.19",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vitest": "^4.1.8"
	}
}
